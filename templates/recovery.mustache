{{!
    Recuperação por etapas: resultado acumulado, execução e o que falta fazer.
}}
<div class="local-progressrecovery">
    <p><a href="{{compareurl}}">{{#str}} comparison, local_progressrecovery {{/str}}</a> · {{filename}}</p>
    <p>{{#str}} recoveryintro, local_progressrecovery {{/str}}</p>

    {{^enabled}}<p class="alert alert-warning">{{#str}} error_recovery_disabled, local_progressrecovery {{/str}}</p>{{/enabled}}
    {{^comparedone}}<p class="alert alert-warning">{{#str}} error_recovery_compare, local_progressrecovery {{/str}}</p>{{/comparedone}}

    {{#running}}
    <div id="local-progressrecovery-compare">
        <p id="local-progressrecovery-compare-status">{{#str}} recovering, local_progressrecovery {{/str}}…</p>
        <div class="progress"><div class="progress-bar" id="local-progressrecovery-compare-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div></div>
        <p class="alert alert-danger hidden" id="local-progressrecovery-compare-error"></p>
        <button type="button" class="btn btn-primary hidden" id="local-progressrecovery-compare-resume">{{#str}} resume, local_progressrecovery {{/str}}</button>
    </div>
    {{/running}}

    {{#hasresult}}
    <h3>{{#str}} recoveryresult, local_progressrecovery {{/str}}</h3>
    {{#finished}}<p>{{#str}} finished, local_progressrecovery {{/str}}: {{finished}}</p>{{/finished}}
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} table, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} opcreated, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} opupdated, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} opstatus_skipped, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} opstatus_failed, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} opstatus_differs, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} opstatus_review, local_progressrecovery {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#resultrows}}<tr><td><code>{{table}}</code></td><td>{{created}}</td><td>{{updated}}</td><td>{{skipped}}</td><td>{{failed}}</td><td>{{differs}}</td><td>{{review}}</td></tr>{{/resultrows}}
        </tbody>
    </table>

    <p><a href="{{exporturl}}">{{#str}} recoveryexport, local_progressrecovery {{/str}}</a> · <a href="{{compensateurl}}">{{#str}} compensation, local_progressrecovery {{/str}}</a></p>

    {{#hasnotes}}
    <h3>{{#str}} recoverynotes, local_progressrecovery {{/str}}</h3>
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} table, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} sourceid, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} entitystatus, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} notes, local_progressrecovery {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#notes}}<tr><td><code>{{table}}</code></td><td>{{sourceid}}</td><td>{{status}}</td><td><code>{{reason}}</code> {{detail}}</td></tr>{{/notes}}
        </tbody>
    </table>
    {{/hasnotes}}

    {{#hascohorts}}
    <h3>{{#str}} recoverygroups, local_progressrecovery {{/str}}</h3>
    <p>{{#str}} recoverygroupsintro, local_progressrecovery {{/str}}</p>
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} cohort, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} membersbefore, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} membersnow, local_progressrecovery {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#cohorts}}<tr><td>{{name}}</td><td>{{before}}</td><td>{{now}}</td></tr>{{/cohorts}}
        </tbody>
    </table>
    <p><strong>{{#str}} pendingwaiting, local_progressrecovery {{/str}}</strong> {{pendingwaiting}} / {{pendingtotal}}</p>
    {{#haswaiting}}
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} username, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} course, local_progressrecovery {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#waiting}}<tr><td>{{username}}</td><td>{{shortname}}</td></tr>{{/waiting}}
        </tbody>
    </table>
    {{/haswaiting}}
    {{/hascohorts}}
    {{/hasresult}}

    {{#stages}}
    <h3>{{title}}</h3>
    <p>{{intro}}</p>
    {{#hasfichas}}<p><strong>{{#str}} recoveryfichas, local_progressrecovery {{/str}}:</strong> {{fichas}}</p>{{/hasfichas}}
    {{#isregistration}}<p><strong>{{#str}} accountstocreate, local_progressrecovery {{/str}}:</strong> {{accounts}} {{accountnames}}</p>{{/isregistration}}
    {{#hasremaining}}
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} table, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} remainingnew, local_progressrecovery {{/str}}</th>
                <th scope="col">{{#str}} remainingchanged, local_progressrecovery {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}<tr><td><code>{{table}}</code></td><td>{{new}}</td><td>{{changed}}</td></tr>{{/rows}}
        </tbody>
    </table>
    {{/hasremaining}}
    {{^hasremaining}}<p class="alert alert-success">{{#str}} stagenothingleft, local_progressrecovery {{/str}}</p>{{/hasremaining}}
    {{#review}}<p class="alert alert-warning">{{#str}} stagereview, local_progressrecovery {{/str}} {{review}}</p>{{/review}}
    {{#waiting}}<p class="alert alert-info">{{#str}} error_recovery_order, local_progressrecovery {{/str}}</p>{{/waiting}}
    {{#canstart}}
    <form method="post" action="{{formurl}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="start" value="1">
        <input type="hidden" name="scope" value="{{scope}}">
        <p><label><input type="checkbox" name="backup" value="1" required> {{#str}} recoverybackup, local_progressrecovery {{/str}}</label></p>
        <button type="submit" class="btn btn-danger">{{action}}</button>
    </form>
    {{/canstart}}
    {{/stages}}
</div>
